<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AJCC.Desktop.Views.ShareDirectoryDialog"
        x:CompileBindings="False"
        Title="Share-Verzeichnisse"
        Width="820"
        Height="610"
        MinWidth="640"
        MinHeight="480"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
  <Grid x:Name="DialogRoot" RowDefinitions="Auto,Auto,*,Auto" Margin="18">
    <TextBlock Text="Share-Verzeichnisse – Entwurf"
               FontSize="17"
               FontWeight="SemiBold" />

    <StackPanel Grid.Row="1" Margin="0,8,0,12">
      <TextBlock x:Name="CurrentPathText"
                 Classes="muted"
                 Text="Core-Dateisystem"
                 TextWrapping="Wrap" />
      <TextBlock x:Name="DirectoryStatusText"
                 Classes="muted"
                 Margin="0,4,0,0"
                 Text="Core-Verzeichnisse werden als Baum geladen. Änderungen bleiben lokal, bis „An Core übertragen“ ausdrücklich bestätigt wird."
                 TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="2" Classes="panel" Padding="8">
      <TreeView x:Name="DirectoryTree"
                MinHeight="300"
                ItemsSource="{Binding RootDirectories}"
                SelectionMode="Single">
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded"
                    Value="{Binding IsExpanded, Mode=TwoWay}" />
          </Style>
        </TreeView.Styles>
        <TreeView.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Öffnen"
                      Click="OpenDirectoryMenuItem_OnClick" />
            <Separator />
            <MenuItem Header="Mit Unterordnern"
                      Click="AddRecursiveShareMenuItem_OnClick" />
            <MenuItem Header="Nur diesen Ordner"
                      Click="AddSingleShareMenuItem_OnClick" />
            <MenuItem Header="Vormerkung entfernen"
                      Click="RemoveShareDraftMenuItem_OnClick" />
            <Separator />
            <MenuItem Header="AppleJuice-Linkliste (.ajl) aus Ordner erstellen..."
                      Click="ExportDirectoryAjlMenuItem_OnClick" />
          </ContextMenu>
        </TreeView.ContextMenu>
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  Margin="4,3"
                  PointerPressed="DirectoryItem_OnPointerPressed"
                  RightTapped="DirectoryItem_OnRightTapped">
              <TextBlock Text="📁"
                         Margin="0,0,6,0" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Name}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2"
                         Classes="muted"
                         Margin="16,0,0,0"
                         Text="{Binding ShareStatus}" />
            </Grid>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Border>

    <Grid Grid.Row="3"
          RowDefinitions="Auto,Auto"
          ColumnDefinitions="Auto,*,Auto,Auto"
          Margin="0,14,0,0">
      <Button Grid.Row="0"
              Grid.Column="0"
              MinWidth="120"
              Content="Baum neu laden"
              Click="ReloadDirectoryButton_OnClick" />
      <Button Grid.Row="0"
              Grid.Column="2"
              MinWidth="150"
              Content="An Core übertragen"
              Click="ApplyToCoreButton_OnClick" />
      <Button Grid.Row="0"
              Grid.Column="3"
              MinWidth="100"
              Margin="8,0,0,0"
              Content="Schließen"
              Click="CloseButton_OnClick" />

      <StackPanel Grid.Row="1"
                  Grid.Column="0"
                  Grid.ColumnSpan="4"
                  Orientation="Horizontal"
                  Margin="0,10,0,0">
        <Button MinWidth="150"
                Content="Mit Unterordnern"
                Click="AddRecursiveShareButton_OnClick" />
        <Button MinWidth="150"
                Margin="8,0,0,0"
                Content="Nur diesen Ordner"
                Click="AddSingleShareButton_OnClick" />
        <Button MinWidth="170"
                Margin="8,0,0,0"
                Content="Vormerkung entfernen"
                Click="RemoveShareDraftButton_OnClick" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
