<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AJCC.Desktop.Views.ShareDirectoryDialog"
        x:CompileBindings="False"
        Title="Share-Verzeichnisse"
        Width="820"
        Height="610"
        MinWidth="640"
        MinHeight="480"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
  <Grid x:Name="DialogRoot" RowDefinitions="Auto,Auto,*,Auto" Margin="18">
    <TextBlock Text="Share-Verzeichnisse – Entwurf"
               FontSize="17"
               FontWeight="SemiBold" />

    <StackPanel Grid.Row="1" Margin="0,8,0,12">
      <TextBlock x:Name="CurrentPathText"
                 Classes="muted"
                 Text="Core-Dateisystem"
                 TextWrapping="Wrap" />
      <TextBlock x:Name="DirectoryStatusText"
                 Classes="muted"
                 Margin="0,4,0,0"
                 Text="Core-Verzeichnisse werden als Baum geladen. Änderungen bleiben lokal, bis „An Core übertragen“ ausdrücklich bestätigt wird."
                 TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal"
                  Spacing="14"
                  Margin="0,8,0,0">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Grid Width="18" Height="16">
            <Canvas Width="16" Height="16">
              <Ellipse Canvas.Left="3.2" Canvas.Top="4.6" Width="9.8" Height="10.2"
                       Fill="#D94A3A" Stroke="#8A241C" StrokeThickness="0.8" />
              <Path Data="M8,4 C7.5,2.7 8.4,1.7 9.6,1.1"
                    Stroke="#6B3D16" StrokeThickness="1.2" />
              <Ellipse Canvas.Left="9.1" Canvas.Top="1.5" Width="4.2" Height="2.5"
                       Fill="#F06A5A" Stroke="#8A241C" StrokeThickness="0.45" />
            </Canvas>
          </Grid>
          <TextBlock Classes="muted" FontSize="11" Text="nicht freigegeben" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Grid Width="18" Height="16"
                ToolTip.Tip="Nicht freigegeben; enthält freigegebene Unterordner">
            <Canvas Width="16" Height="16">
              <Ellipse Canvas.Left="3.2" Canvas.Top="4.6" Width="9.8" Height="10.2"
                       Fill="#D94A3A" Stroke="#8A241C" StrokeThickness="0.8" />
              <Path Data="M8,4 C7.5,2.7 8.4,1.7 9.6,1.1"
                    Stroke="#6B3D16" StrokeThickness="1.2" />
              <Ellipse Canvas.Left="9.1" Canvas.Top="1.5" Width="4.2" Height="2.5"
                       Fill="#F06A5A" Stroke="#8A241C" StrokeThickness="0.45" />
            </Canvas>
            <Ellipse Width="5.2" Height="5.2"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,1,1"
                     Fill="#5FBF4A"
                     Stroke="#2A7A28"
                     StrokeThickness="0.6" />
          </Grid>
          <TextBlock Classes="muted" FontSize="11" Text="enthält Freigabe" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Grid Width="18" Height="16">
            <Canvas Width="16" Height="16">
              <Ellipse Canvas.Left="3.2" Canvas.Top="4.6" Width="9.8" Height="10.2"
                       Fill="#5FBF4A" Stroke="#2A7A28" StrokeThickness="0.8" />
              <Path Data="M8,4 C7.5,2.7 8.4,1.7 9.6,1.1"
                    Stroke="#6B3D16" StrokeThickness="1.2" />
              <Ellipse Canvas.Left="9.1" Canvas.Top="1.5" Width="4.2" Height="2.5"
                       Fill="#7ED957" Stroke="#2A7A28" StrokeThickness="0.45" />
            </Canvas>
          </Grid>
          <TextBlock Classes="muted" FontSize="11" Text="freigegeben" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Grid Width="18" Height="16">
            <Canvas Width="16" Height="16">
              <Ellipse Canvas.Left="3.2" Canvas.Top="4.6" Width="9.8" Height="10.2"
                       Fill="#5FBF4A" Stroke="#2A7A28" StrokeThickness="0.8" />
              <Path Data="M8,4 C7.5,2.7 8.4,1.7 9.6,1.1"
                    Stroke="#6B3D16" StrokeThickness="1.2" />
              <Ellipse Canvas.Left="9.1" Canvas.Top="1.5" Width="4.2" Height="2.5"
                       Fill="#7ED957" Stroke="#2A7A28" StrokeThickness="0.45" />
            </Canvas>
            <Ellipse Width="5.2" Height="5.2"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,1,1"
                     Fill="#D7A51E"
                     Stroke="#8A6210"
                     StrokeThickness="0.6" />
          </Grid>
          <TextBlock Classes="muted" FontSize="11" Text="inkl. Unterordner" />
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="2" Classes="panel" Padding="8">
      <TreeView x:Name="DirectoryTree"
                MinHeight="300"
                ItemsSource="{Binding RootDirectories}"
                SelectionMode="Single">
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded"
                    Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsVisible"
                    Value="{Binding IsVisibleInTree}" />
          </Style>
        </TreeView.Styles>
        <TreeView.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Öffnen"
                      Click="OpenDirectoryMenuItem_OnClick" />
            <Separator />
            <MenuItem Header="Mit Unterordnern"
                      Click="AddRecursiveShareMenuItem_OnClick" />
            <MenuItem Header="Nur diesen Ordner"
                      Click="AddSingleShareMenuItem_OnClick" />
            <MenuItem Header="Vormerkung entfernen"
                      Click="RemoveShareDraftMenuItem_OnClick" />
            <Separator />
            <MenuItem Header="AppleJuice-Linkliste (.ajl) aus Ordner erstellen..."
                      Click="ExportDirectoryAjlMenuItem_OnClick" />
          </ContextMenu>
        </TreeView.ContextMenu>
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  Margin="4,3"
                  PointerPressed="DirectoryItem_OnPointerPressed"
                  RightTapped="DirectoryItem_OnRightTapped">
              <Grid Width="22" Height="18"
                    Margin="0,0,6,0"
                    ToolTip.Tip="{Binding ShareStatus}">
                <Canvas Width="16" Height="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsNotShared}">
                  <Ellipse Canvas.Left="3.2" Canvas.Top="4.6" Width="9.8" Height="10.2"
                           Fill="#D94A3A" Stroke="#8A241C" StrokeThickness="0.8" />
                  <Path Data="M8,4 C7.5,2.7 8.4,1.7 9.6,1.1"
                        Stroke="#6B3D16" StrokeThickness="1.2" />
                  <Ellipse Canvas.Left="9.1" Canvas.Top="1.5" Width="4.2" Height="2.5"
                           Fill="#F06A5A" Stroke="#8A241C" StrokeThickness="0.45" />
                </Canvas>
                <Canvas Width="16" Height="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsShared}">
                  <Ellipse Canvas.Left="3.2" Canvas.Top="4.6" Width="9.8" Height="10.2"
                           Fill="#5FBF4A" Stroke="#2A7A28" StrokeThickness="0.8" />
                  <Path Data="M8,4 C7.5,2.7 8.4,1.7 9.6,1.1"
                        Stroke="#6B3D16" StrokeThickness="1.2" />
                  <Ellipse Canvas.Left="9.1" Canvas.Top="1.5" Width="4.2" Height="2.5"
                           Fill="#7ED957" Stroke="#2A7A28" StrokeThickness="0.45" />
                </Canvas>
                <Ellipse Width="5.2" Height="5.2"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,1,1"
                         Fill="#5FBF4A"
                         Stroke="#2A7A28"
                         StrokeThickness="0.6"
                         IsVisible="{Binding HasSharedDescendant}" />
                <Ellipse Width="5.2" Height="5.2"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,1,1"
                         Fill="#D7A51E"
                         Stroke="#8A6210"
                         StrokeThickness="0.6"
                         IsVisible="{Binding IsRecursiveShared}" />
              </Grid>
              <TextBlock Grid.Column="1"
                         Text="{Binding Name}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2"
                         Classes="muted"
                         Margin="6,0,0,0"
                         Text="{Binding ShareStatus}" />
            </Grid>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Border>

    <Grid Grid.Row="3"
          RowDefinitions="Auto,Auto"
          ColumnDefinitions="Auto,*,Auto,Auto"
          Margin="0,14,0,0">
      <Button Grid.Row="0"
              Grid.Column="0"
              MinWidth="120"
              Content="Baum neu laden"
              Click="ReloadDirectoryButton_OnClick" />
      <Button Grid.Row="0"
              Grid.Column="2"
              MinWidth="150"
              Content="An Core übertragen"
              Click="ApplyToCoreButton_OnClick" />
      <Button Grid.Row="0"
              Grid.Column="3"
              MinWidth="100"
              Margin="8,0,0,0"
              Content="Schließen"
              Click="CloseButton_OnClick" />

      <StackPanel Grid.Row="1"
                  Grid.Column="0"
                  Grid.ColumnSpan="4"
                  Orientation="Horizontal"
                  Margin="0,10,0,0">
        <Button MinWidth="150"
                Content="Mit Unterordnern"
                Click="AddRecursiveShareButton_OnClick" />
        <Button MinWidth="150"
                Margin="8,0,0,0"
                Content="Nur diesen Ordner"
                Click="AddSingleShareButton_OnClick" />
        <Button MinWidth="170"
                Margin="8,0,0,0"
                Content="Vormerkung entfernen"
                Click="RemoveShareDraftButton_OnClick" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
