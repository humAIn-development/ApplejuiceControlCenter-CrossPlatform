<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AJCC.Desktop.Views.CoreProfilePasswordDialog"
        Title="Core-Passwort"
        Width="470"
        Height="250"
        MinWidth="400"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AjBackground}">
  <Border Margin="14"
          Padding="16"
          Background="{DynamicResource AjPanel}"
          BorderBrush="{DynamicResource AjBorder}"
          BorderThickness="1"
          CornerRadius="10">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
      <TextBlock Text="Passwort für Core-Profil"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource AjText}" />

      <TextBlock x:Name="ProfileText"
                 Grid.Row="1"
                 Margin="0,8,0,12"
                 Classes="muted"
                 TextWrapping="Wrap" />

      <TextBox x:Name="PasswordInput"
               Grid.Row="2"
               PlaceholderText="Core-Passwort (leer ist zulässig)"
               PasswordChar="●" />

      <StackPanel Grid.Row="3"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Spacing="8">
        <Button MinWidth="100"
                Content="Abbrechen"
                Click="CancelButton_OnClick" />
        <Button Classes="primary"
                MinWidth="110"
                Content="Weiter"
                Click="ContinueButton_OnClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
