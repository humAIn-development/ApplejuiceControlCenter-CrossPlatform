<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AJCC.Desktop.Views.SettingsDialog"
        x:CompileBindings="False"
        Title="Einstellungen"
        Width="680"
        Height="300"
        MinWidth="560"
        MinHeight="260"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18">
    <StackPanel Spacing="4">
      <TextBlock Text="Einstellungen"
                 FontSize="18"
                 FontWeight="SemiBold" />
      <TextBlock Classes="muted"
                 Text="Desktop-spezifische Einstellungen für AJCC-X."
                 TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1"
            Classes="panel"
            Padding="14"
            Margin="0,14,0,14">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto"
            ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.ColumnSpan="3"
                   Text="Medienwiedergabe mit VLC"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="1"
                   Margin="0,12,12,0"
                   Text="Programm"
                   VerticalAlignment="Center" />
        <TextBox x:Name="VlcPathTextBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Margin="0,8,8,0"
                 IsReadOnly="True"
                 PlaceholderText="Externes VLC-Programm auswählen" />
        <Button Grid.Row="1"
                Grid.Column="2"
                MinWidth="110"
                Margin="0,8,0,0"
                Content="Auswählen…"
                Click="BrowseVlcButton_OnClick" />

        <CheckBox x:Name="VlcEnabledCheckBox"
                  Grid.Row="2"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Margin="0,10,0,0"
                  Content="VLC-Medienwiedergabe aktivieren"
                  Click="VlcEnabledCheckBox_OnClick" />

        <TextBlock x:Name="VlcStatusText"
                   Grid.Row="3"
                   Grid.Column="1"
                   Grid.ColumnSpan="2"
                   Classes="muted"
                   Margin="0,8,0,0"
                   Text="deaktiviert"
                   TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Button Grid.Row="2"
            HorizontalAlignment="Right"
            MinWidth="110"
            Content="Schließen"
            Click="CloseButton_OnClick" />
  </Grid>
</Window>
