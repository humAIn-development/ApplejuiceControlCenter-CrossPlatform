<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AJCC.Desktop.Views.SettingsDialog"
        x:CompileBindings="False"
        Title="Einstellungen"
        Width="760"
        Height="520"
        MinWidth="620"
        MinHeight="430"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18">
    <StackPanel Spacing="4">
      <TextBlock Text="Einstellungen"
                 FontSize="18"
                 FontWeight="SemiBold" />
      <TextBlock Classes="muted"
                 Text="Desktop-spezifische Einstellungen für AJCC-X."
                 TextWrapping="Wrap" />
    </StackPanel>

    <TabControl x:Name="SettingsTabControl"
                Grid.Row="1" Margin="0,14,0,14"
                SelectionChanged="SettingsTabControl_OnSelectionChanged">
      <TabItem Header="Core- und lokale Pfade">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Border Classes="panel" Padding="14" Margin="0,8,0,0">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Grid.ColumnSpan="4"
                       Text="Core-Werte (nur Anzeige)"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="4"
                       Classes="muted"
                       Margin="0,6,0,10"
                       Text="Aktuell vom verbundenen Core aus settings.xml gelesene Werte. Änderungen werden in diesem Schritt nicht angeboten."
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="2"
                       Margin="0,0,12,0"
                       Text="Core-Adresse"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="MappingEndpointText"
                       Grid.Row="2"
                       Grid.Column="1"
                       Grid.ColumnSpan="3"
                       Classes="muted"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Row="3"
                       Margin="0,8,12,0"
                       Text="Benutzername"
                       VerticalAlignment="Center" />
            <TextBox x:Name="CoreNickTextBox"
                     Grid.Row="3"
                     Grid.Column="1"
                     Margin="0,8,8,0"
                     MinWidth="160" />
            <Button x:Name="ApplyCoreNickButton"
                    Grid.Row="3"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    MinWidth="150"
                    Margin="0,8,0,0"
                    Content="An Core übertragen"
                    Click="ApplyCoreNickButton_OnClick" />

            <TextBlock Grid.Row="4"
                       Margin="0,8,12,0"
                       Text="Core-Incoming"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CoreIncomingText"
                       Grid.Row="4"
                       Grid.Column="1"
                       Margin="0,8,8,0"
                       Text="-"
                       TextTrimming="CharacterEllipsis" />
            <Button x:Name="ChangeCoreIncomingButton"
                    Grid.Row="4"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    MinWidth="150"
                    Margin="0,8,0,0"
                    Content="Auswählen…"
                    Click="ChangeCoreIncomingButton_OnClick" />

            <TextBlock Grid.Row="5"
                       Margin="0,8,12,0"
                       Text="Core-Temp"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CoreTemporaryText"
                       Grid.Row="5"
                       Grid.Column="1"
                       Margin="0,8,8,0"
                       Text="-"
                       TextTrimming="CharacterEllipsis" />
            <Button x:Name="ChangeCoreTemporaryButton"
                    Grid.Row="5"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    MinWidth="150"
                    Margin="0,8,0,0"
                    Content="Auswählen…"
                    ToolTip.Tip="Nur änderbar, wenn die Core-Downloadliste vollständig leer ist."
                    Click="ChangeCoreTemporaryButton_OnClick" />

            <TextBlock Grid.Row="6"
                       Margin="0,8,12,0"
                       Text="Core-Port"
                       VerticalAlignment="Center" />
            <TextBox x:Name="CorePortTextBox"
                     Grid.Row="6"
                     Grid.Column="1"
                     Margin="0,8,8,0"
                     MinWidth="120" />
            <Button x:Name="ApplyCorePortButton"
                    Grid.Row="6"
                    Grid.Column="2"
                    MinWidth="150"
                    Margin="0,8,8,0"
                    Content="An Core übertragen"
                    Click="ApplyCorePortButton_OnClick" />
            <Button x:Name="CheckCorePortReachabilityButton"
                    Grid.Row="6"
                    Grid.Column="3"
                    MinWidth="110"
                    Margin="0,8,0,0"
                    Content="Port prüfen"
                    ToolTip.Tip="Prüft rudimentär, ob die vom Core gemeldete externe IP mit dem aktuell wirksamen Core-Port erreichbar ist."
                    Click="CheckCorePortReachabilityButton_OnClick" />

            <TextBlock Grid.Row="7"
                       Margin="0,8,12,0"
                       Text="XML-Port"
                       VerticalAlignment="Center" />
            <TextBox x:Name="CoreXmlPortTextBox"
                     Grid.Row="7"
                     Grid.Column="1"
                     Margin="0,8,8,0"
                     MinWidth="120" />
            <Button x:Name="ApplyCoreXmlPortButton"
                    Grid.Row="7"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    MinWidth="150"
                    Margin="0,8,0,0"
                    Content="An Core übertragen"
                    Click="ApplyCoreXmlPortButton_OnClick" />

            <TextBlock Grid.Row="18"
                       Grid.ColumnSpan="4"
                       Margin="0,18,0,0"
                       Text="Lokales Incoming-Mapping"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="19"
                       Grid.ColumnSpan="4"
                       Classes="muted"
                       Margin="0,6,0,10"
                       Text="Lokaler oder gemounteter Ordner, der aus Sicht dieses Rechners dem Core-Incoming entspricht. Die Zuordnung wird pro Core-Endpunkt gespeichert."
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="20"
                       Margin="0,12,12,0"
                       Text="Lokales Mapping"
                       VerticalAlignment="Center" />
            <TextBox x:Name="LocalIncomingMappingTextBox"
                     Grid.Row="20"
                     Grid.Column="1"
                     Margin="0,8,8,0"
                     IsReadOnly="True"
                     PlaceholderText="Kein lokales Incoming-Mapping gesetzt" />
            <Button Grid.Row="20"
                    Grid.Column="2"
                    MinWidth="110"
                    Margin="0,8,8,0"
                    Content="Auswählen…"
                    Click="BrowseLocalIncomingMappingButton_OnClick" />
            <Button Grid.Row="20"
                    Grid.Column="3"
                    MinWidth="100"
                    Margin="0,8,0,0"
                    Content="Entfernen"
                    Click="RemoveLocalIncomingMappingButton_OnClick" />

          </Grid>
        </Border>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Verbindung">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Border Classes="panel" Padding="14" Margin="0,8,0,0">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="4"
                       Margin="0,18,0,0"
                       Text="Core-Verbindungen"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="4"
                       Classes="muted"
                       Margin="0,6,0,10"
                       Text="Änderungen werden nur über „An Core übertragen“ geschrieben. Schließen allein verändert den Core nicht."
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="2"
                       Margin="0,12,12,0"
                       Text="Max. Verbindungen"
                       VerticalAlignment="Center" />
            <TextBox x:Name="CoreMaxConnectionsTextBox"
                     Grid.Row="2"
                     Grid.Column="1"
                     Margin="0,8,8,0"
                     MinWidth="120" />
            <Button x:Name="ApplyCoreSettingsButton"
                    Grid.Row="2"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    MinWidth="150"
                    Margin="0,8,0,0"
                    Content="An Core übertragen"
                    Click="ApplyCoreSettingsButton_OnClick" />
            <TextBlock Grid.Row="3"
                       Margin="0,12,12,0"
                       Text="Max. Quellen / Datei"
                       VerticalAlignment="Center" />
            <TextBox x:Name="CoreMaxSourcesPerFileTextBox"
                     Grid.Row="3"
                     Grid.Column="1"
                     Margin="0,8,8,0"
                     MinWidth="120" />
            <Button x:Name="ApplyMaxSourcesPerFileButton"
                    Grid.Row="3"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    MinWidth="150"
                    Margin="0,8,0,0"
                    Content="An Core übertragen"
                    Click="ApplyMaxSourcesPerFileButton_OnClick" />

            <TextBlock Grid.Row="4"
                       Margin="0,12,12,0"
                       Text="Max. neue Verbindungen / 10 Sek."
                       VerticalAlignment="Center" />
            <TextBox x:Name="CoreMaxNewConnectionsPerTurnTextBox"
                     Grid.Row="4"
                     Grid.Column="1"
                     Margin="0,8,8,0"
                     MinWidth="120" />
            <Button x:Name="ApplyMaxNewConnectionsPerTurnButton"
                    Grid.Row="4"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    MinWidth="150"
                    Margin="0,8,0,0"
                    Content="An Core übertragen"
                    Click="ApplyMaxNewConnectionsPerTurnButton_OnClick" />

            <CheckBox x:Name="CoreAutoConnectCheckBox"
                      Grid.Row="5"
                      Grid.Column="1"
                      Margin="0,12,8,0"
                      VerticalAlignment="Center"
                      Content="Automatisch verbinden" />
            <Button x:Name="ApplyAutoConnectButton"
                    Grid.Row="5"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    MinWidth="150"
                    Margin="0,8,0,0"
                    Content="An Core übertragen"
                    Click="ApplyAutoConnectButton_OnClick" />

            <TextBlock Grid.Row="6"
                       Margin="0,12,12,0"
                       Text="Max. Download (kb/s)"
                       VerticalAlignment="Center" />
            <TextBox x:Name="CoreMaxDownloadTextBox"
                     Grid.Row="6"
                     Grid.Column="1"
                     Margin="0,8,8,0"
                     MinWidth="120" />
            <Button x:Name="ApplyMaxDownloadButton"
                    Grid.Row="6"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    MinWidth="150"
                    Margin="0,8,0,0"
                    Content="An Core übertragen"
                    Click="ApplyMaxDownloadButton_OnClick" />

            <TextBlock Grid.Row="7"
                       Margin="0,12,12,0"
                       Text="Max. Upload (kb/s)"
                       VerticalAlignment="Center" />
            <TextBox x:Name="CoreMaxUploadTextBox"
                     Grid.Row="7"
                     Grid.Column="1"
                     Margin="0,8,8,0"
                     MinWidth="120"
                     TextChanged="CoreMaxUploadTextBox_OnTextChanged"
                     ToolTip.Tip="Gesamt-Upload in kb/s. Der Core speichert den Wert intern in Bytes." />
            <Button x:Name="ApplyUploadLimitsButton"
                    Grid.Row="7"
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    MinWidth="150"
                    Margin="0,8,0,0"
                    VerticalAlignment="Center"
                    Content="An Core übertragen"
                    Click="ApplyUploadLimitsButton_OnClick" />

            <TextBlock Grid.Row="8"
                       Margin="0,12,12,0"
                       Text="kb/s pro Uploadslot"
                       VerticalAlignment="Center"
                       ToolTip.Tip="Zulässiger Bereich nach Java-GUI: Minimum = MaxUpload^0,2, Maximum = MaxUpload^0,6." />
            <Grid Grid.Row="8"
                  Grid.Column="1"
                  Margin="0,8,8,0"
                  ColumnDefinitions="*,Auto">
              <Slider x:Name="CoreSpeedPerSlotSlider"
                      Minimum="1"
                      Maximum="500"
                      Value="165"
                      TickFrequency="1"
                      IsSnapToTickEnabled="True" />
              <TextBlock Grid.Column="1"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         Classes="muted"
                         Text="{Binding #CoreSpeedPerSlotSlider.Value}" />
            </Grid>

            <TextBlock x:Name="CoreSettingsStatusText"
                       Grid.Row="9"
                       Grid.Column="1"
                       Grid.ColumnSpan="3"
                       Classes="muted"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />

          </Grid>
        </Border>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Passwort">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Border Classes="panel" Padding="14" Margin="0,8,0,0">
          <Grid RowDefinitions="Auto,Auto,Auto"
                ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Grid.ColumnSpan="4"
                       Text="Core-Passwort"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="1"
                       Margin="0,12,12,0"
                       Text="Neues Passwort"
                       VerticalAlignment="Center" />
            <Grid Grid.Row="1"
                  Grid.Column="1"
                  Grid.ColumnSpan="3"
                  Margin="0,8,0,0"
                  ColumnDefinitions="*,*,Auto">
              <TextBox x:Name="NewCorePasswordTextBox"
                       Margin="0,0,8,0"
                       PlaceholderText="Neues Passwort"
                       PasswordChar="●" />
              <TextBox x:Name="ConfirmCorePasswordTextBox"
                       Grid.Column="1"
                       Margin="0,0,8,0"
                       PlaceholderText="Passwort wiederholen"
                       PasswordChar="●" />
              <Button x:Name="ChangeCorePasswordButton"
                      Grid.Column="2"
                      MinWidth="130"
                      Content="Passwort ändern"
                      Click="ChangeCorePasswordButton_OnClick" />
            </Grid>
            <TextBlock Grid.Row="2"
                       Grid.Column="1"
                       Grid.ColumnSpan="3"
                       Classes="muted"
                       Margin="0,6,0,0"
                       Text="Das Passwort wird nur an den Core übertragen und nicht in AJCC-X gespeichert."
                       TextWrapping="Wrap" />
          </Grid>
        </Border>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Proxy">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Border Classes="panel" Padding="14" Margin="0,8,0,0">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnDefinitions="Auto,*">
            <TextBlock Grid.ColumnSpan="2"
                       Text="GUI-Proxy"
                       FontWeight="SemiBold" />

            <CheckBox x:Name="ProxyEnabledCheckBox"
                      Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Margin="0,12,0,0"
                      Content="Proxy für AJCC-X verwenden" />

            <TextBlock Grid.Row="2"
                       Margin="0,12,12,0"
                       Text="Modus"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,8,0,0"
                        Orientation="Horizontal"
                        Spacing="16">
              <RadioButton x:Name="ProxyPublicRadioButton"
                           GroupName="ProxyMode"
                           Content="Public" />
              <RadioButton x:Name="ProxyPrivateRadioButton"
                           GroupName="ProxyMode"
                           Content="Private" />
            </StackPanel>

            <TextBlock Grid.Row="3"
                       Margin="0,12,12,0"
                       Text="Adresse"
                       VerticalAlignment="Center" />
            <TextBox x:Name="ProxyHostTextBox"
                     Grid.Row="3"
                     Grid.Column="1"
                     Margin="0,8,0,0"
                     PlaceholderText="proxy.example.org" />

            <TextBlock Grid.Row="4"
                       Margin="0,12,12,0"
                       Text="Port"
                       VerticalAlignment="Center" />
            <TextBox x:Name="ProxyPortTextBox"
                     Grid.Row="4"
                     Grid.Column="1"
                     Margin="0,8,0,0"
                     Width="120"
                     HorizontalAlignment="Left"
                     PlaceholderText="z. B. 8080" />

            <TextBlock Grid.Row="5"
                       Margin="0,12,12,0"
                       Text="Benutzername"
                       VerticalAlignment="Center" />
            <TextBox x:Name="ProxyUserNameTextBox"
                     Grid.Row="5"
                     Grid.Column="1"
                     Margin="0,8,0,0"
                     PlaceholderText="nur für Private Proxy" />

            <TextBlock Grid.Row="6"
                       Margin="0,12,12,0"
                       Text="Passwort"
                       VerticalAlignment="Center" />
            <Grid Grid.Row="6"
                  Grid.Column="1"
                  Margin="0,8,0,0"
                  ColumnDefinitions="*,Auto">
              <TextBox x:Name="ProxyPasswordTextBox"
                       PasswordChar="●"
                       PlaceholderText="nicht persistent" />
              <Button Grid.Column="1"
                      Margin="8,0,0,0"
                      MinWidth="100"
                      Content="Speichern"
                      Click="SaveGuiProxyConfigurationButton_OnClick" />
            </Grid>

            <TextBlock x:Name="ProxyStatusText"
                       Grid.Row="7"
                       Grid.ColumnSpan="2"
                       Classes="muted"
                       Margin="0,10,0,0"
                       Text="Proxy gilt ausschließlich für GUI-HTTP-Zugriffe von AJCC-X (Feedback und öffentliche Serverliste). Der AppleJuice-Core wird nicht verändert. Private Proxy-Passwörter bleiben nur in der laufenden Sitzung."
                       TextWrapping="Wrap" />
          </Grid>
        </Border>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Ansicht / Oberfläche">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Border Classes="panel" Padding="14" Margin="0,8,0,0">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.ColumnSpan="3"
                       Text="Medienwiedergabe mit VLC"
                       FontWeight="SemiBold" />

            <TextBlock Grid.Row="1"
                       Margin="0,12,12,0"
                       Text="Programm"
                       VerticalAlignment="Center" />
            <TextBox x:Name="VlcPathTextBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     Margin="0,8,8,0"
                     IsReadOnly="True"
                     PlaceholderText="Externes VLC-Programm auswählen" />
            <Button Grid.Row="1"
                    Grid.Column="2"
                    MinWidth="110"
                    Margin="0,8,0,0"
                    Content="Auswählen…"
                    Click="BrowseVlcButton_OnClick" />

            <CheckBox x:Name="VlcEnabledCheckBox"
                      Grid.Row="2"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Margin="0,10,0,0"
                      Content="VLC-Medienwiedergabe aktivieren"
                      Click="VlcEnabledCheckBox_OnClick" />

            <TextBlock x:Name="VlcStatusText"
                       Grid.Row="3"
                       Grid.Column="1"
                       Grid.ColumnSpan="2"
                       Classes="muted"
                       Margin="0,8,0,0"
                       Text="deaktiviert"
                       TextWrapping="Wrap" />

            <CheckBox x:Name="SuppressCoreSwitchConfirmationCheckBox"
                      Grid.Row="4"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Margin="0,18,0,0"
                      Content="Core-Profilwechsel ohne Rückfrage durchführen"
                      ToolTip.Tip="Wenn aktiviert, erfolgt ein manueller Core-Profilwechsel nach Auswahl und Klick auf Wechseln ohne zusätzlichen Bestätigungsdialog."
                      Click="SuppressCoreSwitchConfirmationCheckBox_OnClick" />

            <CheckBox x:Name="AutoLoadShareFilesAtStartupCheckBox"
                      Grid.Row="5"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Margin="0,12,0,0"
                      Content="Share-Dateiliste beim Programmstart automatisch laden"
                      ToolTip.Tip="Komfortoption für kleine und mittlere Shares. Bei sehr großen Sharelisten kann der Start deutlich länger dauern. Nach einem nicht sauber abgeschlossenen Auto-Load deaktiviert AJCC-X die Option beim nächsten Start automatisch."
                      Click="AutoLoadShareFilesAtStartupCheckBox_OnClick" />

            <CheckBox x:Name="GuiSoundsEnabledCheckBox"
                      Grid.Row="6"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Margin="0,12,0,0"
                      Content="Oberflächen-Sounds aktivieren"
                      ToolTip.Tip="Spielt einen kurzen Klicksound beim Wechsel zwischen AJCC-X-Tabs."
                      Click="GuiSoundsEnabledCheckBox_OnClick" />

            <TextBlock Grid.Row="7"
                       Grid.ColumnSpan="3"
                       Margin="0,20,0,0"
                       Text="Download-Statusfarben"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="8"
                       Grid.ColumnSpan="3"
                       Classes="muted"
                       Margin="0,6,0,0"
                       Text="Farben für Fertig, Abgebrochen und Pausiert anpassen. Die Statuslogik selbst bleibt unverändert."
                       TextWrapping="Wrap" />
            <StackPanel Grid.Row="9"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,10,0,0">
              <Button MinWidth="140"
                      Content="Konfigurieren…"
                      Click="ConfigureDownloadStatusColorsButton_OnClick" />
              <Button MinWidth="100"
                      Content="Standard"
                      Click="ResetDownloadStatusColorsButton_OnClick" />
            </StackPanel>
            <TextBlock x:Name="DownloadStatusColorStatusText"
                       Grid.Row="10"
                       Grid.Column="1"
                       Grid.ColumnSpan="2"
                       Classes="muted"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="11"
                       Grid.ColumnSpan="3"
                       Margin="0,20,0,0"
                       Text="Download-Queue"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="12"
                       Grid.ColumnSpan="3"
                       Classes="muted"
                       Margin="0,6,0,0"
                       Text="Begrenzt die Zahl gleichzeitig aktiver Downloads auf dem aktuell verbundenen Core. Die Automatik prüft höchstens alle 20 Sekunden."
                       TextWrapping="Wrap" />
            <StackPanel Grid.Row="13"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,10,0,0">
              <CheckBox x:Name="DownloadQueueEnabledCheckBox"
                        Content="aktiv"
                        VerticalAlignment="Center" />
              <TextBlock Text="Limit"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center" />
              <NumericUpDown x:Name="DownloadQueueLimitInput"
                             Minimum="1"
                             Maximum="100"
                             Increment="1"
                             FormatString="0"
                             Width="90" />
            </StackPanel>
            <StackPanel Grid.Row="14"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Spacing="8"
                        Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <TextBlock Text="Reihenfolge"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="DownloadQueueOrderModeInput"
                          Width="180"
                          SelectedIndex="0"
                          ToolTip.Tip="Automatisch verwendet Fortschritt, aktive Quellen und Quellenzahl. Listenreihenfolge folgt der aktuell sichtbaren Sortierung der Downloadliste; individuelle Queue-Prioritäten haben weiterhin Vorrang.">
                  <ComboBoxItem Content="Automatisch" Tag="Automatic" />
                  <ComboBoxItem Content="Listenreihenfolge" Tag="ListOrder" />
                </ComboBox>
              </StackPanel>
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <CheckBox x:Name="DownloadQueueRotateSourceLessCheckBox"
                          Content="0-Quellen rotieren"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Aktive Queue-Downloads ohne Quellen werden nach dem eingestellten Zeitraum pausiert und für denselben Zeitraum zurückgestellt." />
                <TextBlock Text="nach"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="DownloadQueueSourceLessTimeoutInput"
                          Width="72"
                          SelectedIndex="1"
                          ToolTip.Tip="Zeitraum bis ein aktiver Queue-Download ohne Quellen zurückgestellt wird.">
                  <ComboBoxItem Content="5" Tag="5" />
                  <ComboBoxItem Content="15" Tag="15" />
                  <ComboBoxItem Content="30" Tag="30" />
                  <ComboBoxItem Content="60" Tag="60" />
                </ComboBox>
                <TextBlock Text="Min."
                           VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
            <Button Grid.Row="15"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    MinWidth="110"
                    Margin="0,10,0,0"
                    Content="Übernehmen"
                    Click="SaveDownloadQueueConfigurationButton_OnClick" />
            <TextBlock x:Name="DownloadQueueStatusText"
                       Grid.Row="16"
                       Grid.Column="1"
                       Grid.ColumnSpan="2"
                       Classes="muted"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />
          </Grid>
        </Border>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Konnektoren"
               ToolTip.Tip="Konnektor-/Erweiterungsbereich für spätere optionale Funktionen.">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,8,0,0"
                      Spacing="10">
            <Border Classes="panel"
                    Padding="14">
              <StackPanel Spacing="8">
                <TextBlock Text="Konnektoren"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Text="Dieser Bereich ist als zukünftige Erweiterungszentrale von Applejuice-Control-Center vorgesehen. Aktuell ist hier noch kein aktives Konnektor-System eingebaut."
                           TextWrapping="Wrap" />
                <TextBlock Classes="muted"
                           Text="Unsere Linie: Konnektoren sollen später klar abgegrenzte Aufgaben übernehmen, ohne den AppleJuice-Core unnötig zu belasten oder zu ersetzen."
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="panel"
                    Padding="14">
              <Grid ColumnDefinitions="*,12,*">
                <StackPanel Grid.Column="0"
                            Spacing="8">
                  <TextBlock Text="Future Vision"
                             FontSize="18"
                             FontWeight="SemiBold" />
                  <TextBlock Classes="muted"
                             Text="Konnektoren können später servernahe Zusatzfunktionen bereitstellen. AJCC würde diese Funktionen kontrolliert ansprechen, Status anzeigen und Fehler sichtbar machen."
                             TextWrapping="Wrap" />
                  <TextBlock Classes="muted"
                             Text="Vorgedachte Richtung: Linux-first, getrennt vom Core, bewusst aktivierbar, sauber protokolliert."
                             TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Spacing="8">
                  <TextBlock Text="Nicht das Ziel"
                             FontSize="18"
                             FontWeight="SemiBold" />
                  <TextBlock Classes="muted"
                             Text="Kein beliebiger Fremdcode, keine automatische Netzwerk-Magie, keine zusätzliche Last beim normalen Start und keine versteckte Überwachung."
                             TextWrapping="Wrap" />
                  <TextBlock Classes="muted"
                             Text="Der Core bleibt die Arbeitsmaschine. Konnektoren wären optionale Helfer, nicht Ersatz oder Eingriff in den Core."
                             TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="panel"
                    Padding="14">
              <Grid ColumnDefinitions="*,12,*">
                <StackPanel Grid.Column="0"
                            Spacing="6">
                  <TextBlock Text="Tunnel-/Relay-Vision"
                             FontWeight="SemiBold" />
                  <TextBlock Classes="muted"
                             Text="Langfristige Idee für schwierige Erreichbarkeitssituationen. Anspruchsvoll, optional und nicht Teil dieses Pre-Releases."
                             TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Spacing="6">
                  <TextBlock Text="Diagnose und Status"
                             FontWeight="SemiBold" />
                  <TextBlock Classes="muted"
                             Text="Konnektorstatus, Logs und klare Fehlerhinweise, ohne normale AJCC-Funktionen zu stören."
                             TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Info"
               ToolTip.Tip="Info-, Build- und Plattformhinweise zu AJCC-X.">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,8,0,0"
                      Spacing="10">
            <Border Classes="panel"
                    Padding="14">
              <StackPanel Spacing="8">
                <TextBlock Text="Über AJCC-X"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="InfoVersionText"
                           FontWeight="SemiBold"
                           Text="Version wird geladen..."
                           TextWrapping="Wrap" />
                <TextBlock x:Name="InfoBuildText"
                           Classes="muted"
                           Text="Build wird geladen..."
                           TextWrapping="Wrap" />
                <TextBlock Text="AJCC-X ist die plattformübergreifende Desktop-GUI für den vorhandenen AppleJuice-Core. Die GUI steuert den Core über dessen Schnittstellen; sie ersetzt oder erweitert den Core selbst nicht."
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="panel"
                    Padding="14">
              <Grid ColumnDefinitions="Auto,*"
                    RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Text="Produkt"
                           Margin="0,0,16,8"
                           Classes="muted" />
                <TextBlock Grid.Column="1"
                           Margin="0,0,0,8"
                           Text="Applejuice-Control-Center Cross-Platform" />
                <TextBlock Grid.Row="1"
                           Text="Version / Build"
                           Margin="0,0,16,8"
                           Classes="muted" />
                <TextBlock x:Name="InfoDiagnosticVersionText"
                           Grid.Row="1"
                           Grid.Column="1"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="2"
                           Text="Laufzeit"
                           Margin="0,0,16,8"
                           Classes="muted" />
                <TextBlock x:Name="InfoPlatformText"
                           Grid.Row="2"
                           Grid.Column="1"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="3"
                           Text="Zielplattformen"
                           Margin="0,0,16,0"
                           Classes="muted" />
                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Text="Windows · Linux · macOS"
                           TextWrapping="Wrap" />
              </Grid>
            </Border>

            <Border Classes="panel"
                    Padding="14">
              <StackPanel Spacing="6">
                <TextBlock Text="FirstLight"
                           FontWeight="SemiBold" />
                <TextBlock Classes="muted"
                           Text="v0.0.2 ist weiterhin ein Testbuild. Packaging, Installer, Protokoll-/Dateizuordnungen und eine spätere Freigabe nach main bleiben getrennte Entscheidungen."
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Button Grid.Row="2"
            HorizontalAlignment="Right"
            MinWidth="110"
            Content="Schließen"
            Click="CloseButton_OnClick" />
  </Grid>
</Window>
