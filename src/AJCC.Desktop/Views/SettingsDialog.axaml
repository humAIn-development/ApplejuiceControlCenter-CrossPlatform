<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AJCC.Desktop.Views.SettingsDialog"
        x:CompileBindings="False"
        Title="Einstellungen"
        Width="760"
        Height="520"
        MinWidth="620"
        MinHeight="430"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18">
    <StackPanel Spacing="4">
      <TextBlock Text="Einstellungen"
                 FontSize="18"
                 FontWeight="SemiBold" />
      <TextBlock Classes="muted"
                 Text="Desktop-spezifische Einstellungen für AJCC-X."
                 TextWrapping="Wrap" />
    </StackPanel>

    <TabControl Grid.Row="1" Margin="0,14,0,14">
      <TabItem Header="Core- und lokale Pfade">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Border Classes="panel" Padding="14" Margin="0,8,0,0">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Grid.ColumnSpan="4"
                       Text="Core-Werte (nur Anzeige)"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="4"
                       Classes="muted"
                       Margin="0,6,0,10"
                       Text="Aktuell vom verbundenen Core aus settings.xml gelesene Werte. Änderungen werden in diesem Schritt nicht angeboten."
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="2"
                       Margin="0,0,12,0"
                       Text="Core-Adresse"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="MappingEndpointText"
                       Grid.Row="2"
                       Grid.Column="1"
                       Grid.ColumnSpan="3"
                       Classes="muted"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Row="3"
                       Margin="0,8,12,0"
                       Text="Benutzername"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CoreNickText"
                       Grid.Row="3"
                       Grid.Column="1"
                       Grid.ColumnSpan="3"
                       Margin="0,8,0,0"
                       Text="-" />

            <TextBlock Grid.Row="4"
                       Margin="0,8,12,0"
                       Text="Core-Incoming"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CoreIncomingText"
                       Grid.Row="4"
                       Grid.Column="1"
                       Grid.ColumnSpan="3"
                       Margin="0,8,0,0"
                       Text="-"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Row="5"
                       Margin="0,8,12,0"
                       Text="Core-Temp"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CoreTemporaryText"
                       Grid.Row="5"
                       Grid.Column="1"
                       Grid.ColumnSpan="3"
                       Margin="0,8,0,0"
                       Text="-"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Row="6"
                       Margin="0,8,12,0"
                       Text="Core-Port"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CorePortText"
                       Grid.Row="6"
                       Grid.Column="1"
                       Grid.ColumnSpan="3"
                       Margin="0,8,0,0"
                       Text="-" />

            <TextBlock Grid.Row="7"
                       Margin="0,8,12,0"
                       Text="XML-Port"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CoreXmlPortText"
                       Grid.Row="7"
                       Grid.Column="1"
                       Grid.ColumnSpan="3"
                       Margin="0,8,0,0"
                       Text="-" />

            <TextBlock Grid.Row="8"
                       Grid.ColumnSpan="4"
                       Margin="0,18,0,0"
                       Text="Core-Verbindungen"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="9"
                       Grid.ColumnSpan="4"
                       Classes="muted"
                       Margin="0,6,0,10"
                       Text="Änderungen werden nur über „An Core übertragen“ geschrieben. Schließen allein verändert den Core nicht."
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="10"
                       Margin="0,12,12,0"
                       Text="Max. Verbindungen"
                       VerticalAlignment="Center" />
            <TextBox x:Name="CoreMaxConnectionsTextBox"
                     Grid.Row="10"
                     Grid.Column="1"
                     Margin="0,8,8,0"
                     MinWidth="120" />
            <Button x:Name="ApplyCoreSettingsButton"
                    Grid.Row="10"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    MinWidth="150"
                    Margin="0,8,0,0"
                    Content="An Core übertragen"
                    Click="ApplyCoreSettingsButton_OnClick" />
            <TextBlock Grid.Row="11"
                       Margin="0,12,12,0"
                       Text="Max. Quellen / Datei"
                       VerticalAlignment="Center" />
            <TextBox x:Name="CoreMaxSourcesPerFileTextBox"
                     Grid.Row="11"
                     Grid.Column="1"
                     Margin="0,8,8,0"
                     MinWidth="120" />
            <Button x:Name="ApplyMaxSourcesPerFileButton"
                    Grid.Row="11"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    MinWidth="150"
                    Margin="0,8,0,0"
                    Content="An Core übertragen"
                    Click="ApplyMaxSourcesPerFileButton_OnClick" />

            <TextBlock Grid.Row="12"
                       Margin="0,12,12,0"
                       Text="Max. neue Verbindungen / 10 Sek."
                       VerticalAlignment="Center" />
            <TextBox x:Name="CoreMaxNewConnectionsPerTurnTextBox"
                     Grid.Row="12"
                     Grid.Column="1"
                     Margin="0,8,8,0"
                     MinWidth="120" />
            <Button x:Name="ApplyMaxNewConnectionsPerTurnButton"
                    Grid.Row="12"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    MinWidth="150"
                    Margin="0,8,0,0"
                    Content="An Core übertragen"
                    Click="ApplyMaxNewConnectionsPerTurnButton_OnClick" />

            <TextBlock x:Name="CoreSettingsStatusText"
                       Grid.Row="13"
                       Grid.Column="1"
                       Grid.ColumnSpan="3"
                       Classes="muted"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="14"
                       Grid.ColumnSpan="4"
                       Margin="0,18,0,0"
                       Text="Lokales Incoming-Mapping"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="15"
                       Grid.ColumnSpan="4"
                       Classes="muted"
                       Margin="0,6,0,10"
                       Text="Lokaler oder gemounteter Ordner, der aus Sicht dieses Rechners dem Core-Incoming entspricht. Die Zuordnung wird pro Core-Endpunkt gespeichert."
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="16"
                       Margin="0,12,12,0"
                       Text="Lokales Mapping"
                       VerticalAlignment="Center" />
            <TextBox x:Name="LocalIncomingMappingTextBox"
                     Grid.Row="16"
                     Grid.Column="1"
                     Margin="0,8,8,0"
                     IsReadOnly="True"
                     PlaceholderText="Kein lokales Incoming-Mapping gesetzt" />
            <Button Grid.Row="16"
                    Grid.Column="2"
                    MinWidth="110"
                    Margin="0,8,8,0"
                    Content="Auswählen…"
                    Click="BrowseLocalIncomingMappingButton_OnClick" />
            <Button Grid.Row="16"
                    Grid.Column="3"
                    MinWidth="100"
                    Margin="0,8,0,0"
                    Content="Entfernen"
                    Click="RemoveLocalIncomingMappingButton_OnClick" />
          </Grid>
        </Border>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Ansicht / Oberfläche">
        <Border Classes="panel" Padding="14" Margin="0,8,0,0">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.ColumnSpan="3"
                       Text="Medienwiedergabe mit VLC"
                       FontWeight="SemiBold" />

            <TextBlock Grid.Row="1"
                       Margin="0,12,12,0"
                       Text="Programm"
                       VerticalAlignment="Center" />
            <TextBox x:Name="VlcPathTextBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     Margin="0,8,8,0"
                     IsReadOnly="True"
                     PlaceholderText="Externes VLC-Programm auswählen" />
            <Button Grid.Row="1"
                    Grid.Column="2"
                    MinWidth="110"
                    Margin="0,8,0,0"
                    Content="Auswählen…"
                    Click="BrowseVlcButton_OnClick" />

            <CheckBox x:Name="VlcEnabledCheckBox"
                      Grid.Row="2"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Margin="0,10,0,0"
                      Content="VLC-Medienwiedergabe aktivieren"
                      Click="VlcEnabledCheckBox_OnClick" />

            <TextBlock x:Name="VlcStatusText"
                       Grid.Row="3"
                       Grid.Column="1"
                       Grid.ColumnSpan="2"
                       Classes="muted"
                       Margin="0,8,0,0"
                       Text="deaktiviert"
                       TextWrapping="Wrap" />
          </Grid>
        </Border>
      </TabItem>
    </TabControl>

    <Button Grid.Row="2"
            HorizontalAlignment="Right"
            MinWidth="110"
            Content="Schließen"
            Click="CloseButton_OnClick" />
  </Grid>
</Window>
