<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AJCC.Desktop.Views.CoreDirectoryPickerDialog"
        x:CompileBindings="False"
        Title="Core-Verzeichnis auswählen"
        Width="720"
        Height="560"
        MinWidth="560"
        MinHeight="420"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18">
    <TextBlock Text="Core-Verzeichnis auswählen"
               FontSize="17"
               FontWeight="SemiBold" />

    <StackPanel Grid.Row="1" Margin="0,8,0,12">
      <TextBlock Classes="muted"
                 Text="Der Verzeichnisbaum wird direkt vom verbundenen Core geladen. Eine freie Texteingabe ist absichtlich nicht möglich."
                 TextWrapping="Wrap" />
      <TextBlock x:Name="DirectoryStatusText"
                 Classes="muted"
                 Margin="0,5,0,0"
                 Text="Core-Verzeichnisbaum wird geladen ..."
                 TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="2" Classes="panel" Padding="8">
      <TreeView x:Name="DirectoryTree"
                MinHeight="280"
                ItemsSource="{Binding RootDirectories}">
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded"
                    Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsVisible"
                    Value="{Binding IsVisibleInTree}" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="4,3">
              <TextBlock Text="📁" Margin="0,0,6,0" />
              <TextBlock Text="{Binding Name}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Border>

    <Grid Grid.Row="3"
          ColumnDefinitions="Auto,*,Auto,Auto"
          Margin="0,14,0,0">
      <Button Grid.Column="0"
              MinWidth="120"
              Content="Baum neu laden"
              Click="ReloadButton_OnClick" />
      <Button Grid.Column="2"
              MinWidth="120"
              Content="Auswaehlen"
              Click="AcceptButton_OnClick" />
      <Button Grid.Column="3"
              MinWidth="100"
              Margin="8,0,0,0"
              Content="Abbrechen"
              Click="CancelButton_OnClick" />
    </Grid>
  </Grid>
</Window>
