<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:AJCC.Core.Models"
        x:Class="AJCC.Desktop.Views.ShareSnapshotDiffDialog"
        Title="Share-Vergleich"
        Width="1120"
        Height="720"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AjBackground}">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18">
    <Border Grid.Row="0"
            Padding="14"
            Margin="0,0,0,10"
            Background="{DynamicResource AjPanel}"
            BorderBrush="{DynamicResource AjBorder}"
            BorderThickness="1"
            CornerRadius="10">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock x:Name="ResultHeadlineText"
                     FontSize="19"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="ResultDetailText"
                     Margin="0,6,14,0"
                     Classes="muted"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Column="1"
                MinWidth="145"
                Padding="12,8"
                Background="{DynamicResource AjBackground}"
                BorderBrush="{DynamicResource AjBorder}"
                BorderThickness="1"
                CornerRadius="8">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Classes="muted"
                       Text="Änderungen"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="ResultCountText"
                       Margin="0,2,0,0"
                       FontSize="22"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              Grid.ColumnSpan="2"
              ColumnDefinitions="*,*,*,*"
              Margin="0,12,0,0">
          <Border Grid.Column="0"
                  Margin="0,0,6,0"
                  Padding="9"
                  Background="{DynamicResource AjBackground}"
                  BorderBrush="{DynamicResource AjBorder}"
                  BorderThickness="1"
                  CornerRadius="7">
            <StackPanel>
              <TextBlock Classes="muted" Text="Dateien aktuell" />
              <TextBlock x:Name="CurrentFileCountText"
                         Margin="0,2,0,0"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1"
                  Margin="2,0,4,0"
                  Padding="9"
                  Background="{DynamicResource AjBackground}"
                  BorderBrush="{DynamicResource AjBorder}"
                  BorderThickness="1"
                  CornerRadius="7">
            <StackPanel>
              <TextBlock Classes="muted" Text="Dateidifferenz" />
              <TextBlock x:Name="FileDeltaText"
                         Margin="0,2,0,0"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2"
                  Margin="4,0,2,0"
                  Padding="9"
                  Background="{DynamicResource AjBackground}"
                  BorderBrush="{DynamicResource AjBorder}"
                  BorderThickness="1"
                  CornerRadius="7">
            <StackPanel>
              <TextBlock Classes="muted" Text="Sharegröße aktuell" />
              <TextBlock x:Name="CurrentSizeText"
                         Margin="0,2,0,0"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <Border Grid.Column="3"
                  Margin="6,0,0,0"
                  Padding="9"
                  Background="{DynamicResource AjBackground}"
                  BorderBrush="{DynamicResource AjBorder}"
                  BorderThickness="1"
                  CornerRadius="7">
            <StackPanel>
              <TextBlock Classes="muted" Text="Größendifferenz" />
              <TextBlock x:Name="SizeDeltaText"
                         Margin="0,2,0,0"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <ListBox x:Name="NoticesList"
             Grid.Row="1"
             MaxHeight="120"
             Margin="0,0,0,10">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="models:ShareSnapshotNotice">
          <Grid ColumnDefinitions="100,150,*" Margin="8,5">
            <TextBlock Text="{Binding SeverityText}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Category}"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Column="2"
                       Text="{Binding Message}"
                       TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TabControl Grid.Row="2">
      <TabItem x:Name="AddedFilesTab" Header="Neue Dateien">
        <ListBox x:Name="AddedFilesList">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:ShareSnapshotFileChange">
              <Grid ColumnDefinitions="2*,4*,Auto" Margin="8,5">
                <TextBlock Text="{Binding Filename}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DirectoryPath}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Margin="10,0,0,0"
                           Text="{Binding CurrentSizeText}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>

      <TabItem x:Name="RemovedFilesTab" Header="Entfernte Dateien">
        <ListBox x:Name="RemovedFilesList">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:ShareSnapshotFileChange">
              <Grid ColumnDefinitions="2*,4*,Auto" Margin="8,5">
                <TextBlock Text="{Binding Filename}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DirectoryPath}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Margin="10,0,0,0"
                           Text="{Binding PreviousSizeText}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>

      <TabItem x:Name="ChangedFilesTab" Header="Veränderte Dateien">
        <ListBox x:Name="ChangedFilesList">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:ShareSnapshotFileChange">
              <Grid ColumnDefinitions="2*,3*,Auto,Auto,1.5*" Margin="8,5">
                <TextBlock Text="{Binding Filename}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DirectoryPath}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Margin="10,0,0,0"
                           Text="{Binding PreviousSizeText}" />
                <TextBlock Grid.Column="3"
                           Margin="10,0,0,0"
                           Text="{Binding CurrentSizeText}" />
                <TextBlock Grid.Column="4"
                           Margin="10,0,0,0"
                           Text="{Binding ChangeText}"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>

      <TabItem x:Name="DirectoriesTab" Header="Ordneränderungen">
        <ListBox x:Name="DirectoriesList">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:ShareSnapshotDirectoryDelta">
              <Grid ColumnDefinitions="4*,Auto,Auto,Auto,Auto" Margin="8,5">
                <TextBlock Text="{Binding DirectoryPath}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           Text="{Binding AddedCount}" />
                <TextBlock Grid.Column="2"
                           Margin="10,0,0,0"
                           Text="{Binding RemovedCount}" />
                <TextBlock Grid.Column="3"
                           Margin="10,0,0,0"
                           Text="{Binding ChangedCount}" />
                <TextBlock Grid.Column="4"
                           Margin="10,0,0,0"
                           Text="{Binding NetFileCountText}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>

      <TabItem x:Name="RootsTab" Header="Freigabewurzeln">
        <ListBox x:Name="RootsList">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:ShareSnapshotRootChange">
              <Grid ColumnDefinitions="1.5*,3*,Auto,Auto,4*" Margin="8,5">
                <TextBlock Text="{Binding ChangeText}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Path}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Margin="10,0,0,0"
                           Text="{Binding PreviousModeText}" />
                <TextBlock Grid.Column="3"
                           Margin="10,0,0,0"
                           Text="{Binding CurrentModeText}" />
                <TextBlock Grid.Column="4"
                           Margin="10,0,0,0"
                           Text="{Binding Detail}"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
    </TabControl>

    <Border Grid.Row="3"
            Margin="0,10,0,0"
            Padding="10"
            Background="{DynamicResource AjPanel}"
            BorderBrush="{DynamicResource AjBorder}"
            BorderThickness="1"
            CornerRadius="8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="FooterStatusText"
                   Classes="muted"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
          <Button x:Name="SaveBaselineButton"
                  MinWidth="250"
                  Content="Aktuellen Stand als Vergleichsbasis speichern"
                  Click="SaveBaselineButton_OnClick" />
          <Button MinWidth="120"
                  Content="Bericht kopieren"
                  Click="CopyReportButton_OnClick" />
          <Button MinWidth="100"
                  Content="Schließen"
                  Click="CloseButton_OnClick" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
