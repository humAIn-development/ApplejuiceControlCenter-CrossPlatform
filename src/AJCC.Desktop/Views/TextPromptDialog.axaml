<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AJCC.Desktop.Views.TextPromptDialog"
        Title="Eingabe"
        Width="560"
        Height="245"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18">
    <TextBlock x:Name="PromptText"
               FontSize="16"
               FontWeight="SemiBold"
               TextWrapping="Wrap" />

    <TextBlock x:Name="DetailText"
               Grid.Row="1"
               Classes="muted"
               Margin="0,7,0,10"
               TextWrapping="Wrap" />

    <TextBox x:Name="InputTextBox"
             Grid.Row="2"
             VerticalAlignment="Top" />

    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,16,0,0">
      <Button MinWidth="96"
              Content="Zurück"
              Click="CancelButton_OnClick" />
      <Button x:Name="AcceptButton"
              Classes="primary"
              MinWidth="110"
              Content="Übernehmen"
              Click="AcceptButton_OnClick" />
    </StackPanel>
  </Grid>
</Window>
